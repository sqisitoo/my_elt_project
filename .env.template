# -- Airflow configuration --
AIRFLOW_PATH_TO_DOCKERFILE=docker/airflow/Dockerfile
AIRFLOW_UID=50000

# -- Air pollution api configuration --
API_BASE_URL=http://api.openweathermap.org
API_KEY=mock_key

# -- AWS credentials for S3 connection --
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=mock_bucket_name

# -- Python configuration --
PYTHONPATH=/opt/airflow

# -- Other configuration --
DBT_PROFILES_DIR=/opt/airflow/dbt_project
DBT_PROJECT_DIR=/opt/airflow/dbt_project
DBT_TARGET=dev

# -- Database configuration --
DB_USER=postgres
DB_PASSWORD=mock_pasword
DB_HOST=host
DB_PORT=5432
DB_NAME=postgres

# -- Snowflake configuration --
SNOWFLAKE_USER=SNOWFLAKE_USER
SNOWFLAKE_ACCOUNT=SNOWFLAKE_ACCOUNT
SNOWFLAKE_DATABASE=SNOWFLAKE_DATABASE
SNOWFLAKE_SCHEMA=SNOWFLAKE_SCHEMA
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_WAREHOUSE
SNOWFLAKE_ROLE=SNOWFLAKE_ROLE
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/snowflake_tf_snow_key.p8